# Supabase project settings (Project Settings > API keys).
# Both values are public; data access is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claude API key (console.anthropic.com > Settings > API Keys).
# Secret: server-only, never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional: accounts without daily usage limits, comma separated.
UNLIMITED_EMAILS=
